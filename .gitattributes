# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Windows scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.whl binary
*.gz binary
*.tar binary
*.zip binary
*.db binary
*.sqlite binary
*.bundle binary
